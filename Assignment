import java.util.Scanner;

public class DecimalToBinaryB {

    // Function that returns array
    public static int[] toBinaryArray(int num) {
        int temp = num;
        int count = 0;

        // count bits
        while (temp > 0) {
            temp /= 2;
            count++;
        }

        int[] binary = new int[count];

        // fill array
        for (int i = count - 1; i >= 0; i--) {
            binary[i] = num % 2;
            num /= 2;
        }

        return binary;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter an integer: ");
        int num = sc.nextInt();

        int[] result = toBinaryArray(num);

        System.out.print("Binary Array: ");
        for (int bit : result) {
            System.out.print(bit);
        }

        sc.close();
    }
}


import java.util.Scanner;

public class DecimalToBinaryC {

    // Function that returns string
    public static String toBinaryString(int num) {
        String binary = "";

        while (num > 0) {
            binary = (num % 2) + binary;
            num /= 2;
        }

        return binary;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter an integer: ");
        int num = sc.nextInt();

        String result = toBinaryString(num);

        System.out.println("Binary String: " + result);

        sc.close();
    }
}
